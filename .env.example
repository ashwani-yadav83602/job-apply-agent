# Copy this file to .env and fill in real values. Never commit .env.

# Only needed if you want the agent to tailor your resume/cover letter
# summary automatically. Leave blank to skip tailoring and use your
# resume/cover letter files as-is.
ANTHROPIC_API_KEY=

# Path to your saved Indeed browser session (created by `npm run login`)
INDEED_AUTH_STATE_PATH=./indeed-auth.json

# Path to your base resume PDF/DOCX that gets uploaded to Indeed
DEFAULT_RESUME_PATH=./resumes/resume.pdf
